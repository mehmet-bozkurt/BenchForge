APP_NAME=BenchForge
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://benchforge.test
# Runner scripts and the starting template ship in ./engine. The data root holds
# runs/, prompts/ and config/ and defaults to ./engine. Set it to keep run data elsewhere.
# After setup, Sistem ve Kurulum can save a local override. No files are moved.
# BENCHFORGE_ROOT=/absolute/path/to/benchforge-data
# Results must be the same physical directory as BENCHFORGE_ROOT/runs.
# BENCHFORGE_RUNS_DIR=/absolute/path/to/benchforge-data/runs
BENCHFORGE_NODE_BINARY=node
BENCHFORGE_SHELL_BINARY=zsh
# BENCHFORGE_COMMAND_PATH=/path/to/node/bin:/path/to/opencode/bin:/usr/local/bin:/usr/bin:/bin
# BENCHFORGE_HOME=/absolute/path/to/your-user-directory

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# SQLite defaults to this application's database/database.sqlite.
# DB_DATABASE=/absolute/path/to/BenchForge/database/database.sqlite
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
